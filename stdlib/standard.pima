// Pima standard library

function math_pow (:base :exponent) {
    if [< exponent 0] {
        / 1 [math_pow base [- 0 exponent]]
    } {
        if [= exponent 0] 1 [* base [math_pow base [- exponent 1]]]
    }
}

function math_lte (:left :right) {
    if [< left right] true [= left right]
}

function math_gte (:left :right) {
    if [> left right] true [= left right]
}

function math_increment (:value) {
    + value 1
}

function math_decrement (:value) {
    - value 1
}

function math_range (:begin :end) {
    set step [logic_select [math_lte begin end] math_increment math_decrement]
    if [= begin end] {
        List.append () begin
    } {
        List.push [math_range [step begin] end] begin
    }
}

function math_absolute (:value) {
    if [< value 0] [- 0 value] value
}

function math_minimum (:left :right) {
    if [< left right] left right
}

function math_maximum (:left :right) {
    if [> left right] left right
}

function math_clamp (:value :minimum :maximum) {
    math_minimum [math_maximum value minimum] maximum
}

function math_sum (:list) {
    if [List.empty? list] 0 {
        + [List.head list] [math_sum [List.rest list]]
    }
}

function math_product (:list) {
    if [List.empty? list] 1 {
        * [List.head list] [math_product [List.rest list]]
    }
}

function math_average (:list) {
    / [math_sum list] [list_length list]
}

function list_reverse (:list) {
    if [List.empty? list] () {
        List.append [list_reverse [List.rest list]] [List.head list]
    }
}

function list_foreach (:list :block) {
    if [Logic.not [List.empty? list]] {
        set item [List.head list]
        do block
        list_foreach [List.rest list] block
    } {
    }
}

function list_map (:callable :list) {
    if [List.empty? list] {
        ()
    } {
        List.push [list_map callable [List.rest list]] [callable [List.head list]]
    }
}

function list_length (:list) {
    if [List.empty? list] 0 [+ 1 [list_length [List.rest list]]]
}

function list_contains (:list :value) {
    if [List.empty? list] false {
        if [= [List.head list] value] true [list_contains [List.rest list] value]
    }
}

function list_fold (:callable :initial :list) {
    if [List.empty? list] initial {
        list_fold callable [callable initial [List.head list]] [List.rest list]
    }
}

function list_filter (:predicate :list) {
    if [List.empty? list] {
        ()
    } {
        set tail [list_filter predicate [List.rest list]]
        if [predicate [List.head list]] {
            List.push tail [List.head list]
        } {
            tail
        }
    }
}

function list_any (:predicate :list) {
    if [List.empty? list] false {
        if [predicate [List.head list]] true [list_any predicate [List.rest list]]
    }
}

function list_all (:predicate :list) {
    if [List.empty? list] true {
        if [predicate [List.head list]] [list_all predicate [List.rest list]] false
    }
}

function logic_select (:predicate :when_true :when_false) {
    if predicate when_true when_false
}

pub set Math [new {
    pub set E 2.718281828459045
    pub set PI 3.141592653589793
    pub set pow math_pow
    pub set less_or_equal math_lte
    pub set greater_or_equal math_gte
    pub set increment math_increment
    pub set decrement math_decrement
    pub set range math_range
    pub set absolute math_absolute
    pub set minimum math_minimum
    pub set maximum math_maximum
    pub set clamp math_clamp
    pub set sum math_sum
    pub set product math_product
    pub set average math_average
    pub set div Math.div
    pub set mod Math.mod
    pub set int Math.int
}]

pub set String [new {
    pub set concat String.concat
    pub set length String.length
    pub set byte_length String.byte_length
    pub set slice String.slice
    pub set chars String.chars
    pub set code_point String.code_point
    pub set from_code_point String.from_code_point
    pub set from String.string
    pub set string String.string
    pub set lower String.lower
    pub set upper String.upper
    pub set trim String.trim
    pub set contains? String.contains?
    pub set starts_with? String.starts_with?
    pub set ends_with? String.ends_with?
    pub set replace String.replace
    pub set split String.split
    pub set join String.join
}]

pub set List [new {
    pub set push List.push
    pub set append List.append
    pub set head List.head
    pub set rest List.rest
    pub set empty? List.empty?
    pub set reverse list_reverse
    pub set foreach list_foreach
    pub set map list_map
    pub set length list_length
    pub set contains? list_contains
    pub set fold list_fold
    pub set filter list_filter
    pub set any? list_any
    pub set all? list_all
}]

pub set Types [new {
    pub set of Types.types
    pub set is? Types.is?
}]

pub set Console [new {
    pub set println Console.println
}]

pub set Logic [new {
    pub set not Logic.not
    pub set select logic_select
}]
