import "/po/library/standard"


set year_size 365

function birthday_paradox (:probability :num_of_people) {
	set new_probability [* [/ [- year_size num_of_people] year_size] probability]
	if [< new_probability 0.5] {
		+ num_of_people 1
	} {
		birthday_paradox new_probability [+ num_of_people 1]
	}
}

birthday_paradox 1 1
